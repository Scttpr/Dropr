# Dropr container image for non-Nix users. Build from the repository root:
#
#   podman build -f deploy/Containerfile --build-arg VERSION=v0.1.0 -t dropr:v0.1.0 .
#
# The Nix build (`nix build .#image`) is the reference, fully reproducible
# build; this file is the portable alternative. Base images are pinned by
# digest. Refresh them deliberately, e.g.:
#   podman pull docker.io/library/node:24-bookworm-slim && podman image inspect ... RepoDigests

# --- 1. Browser assets (esbuild, content-hashed, deterministic) --------------
FROM docker.io/library/node:24-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9 AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run typecheck && npm test && npm run build -- --outdir /out

# --- 2. Static Go binary ------------------------------------------------------
FROM docker.io/library/golang:1.26-bookworm@sha256:2dcb1e14f35e4cc1db2186947cba2d19a9fce4d48a27c50658bd203c90fcc183 AS go
ARG VERSION=dev
ENV CGO_ENABLED=0 GOFLAGS=-mod=readonly
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
COPY --from=web /out/ internal/web/static/
RUN go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/dropr ./cmd/dropr
# Empty, correctly owned data directory for the volume.
RUN mkdir -p /out/data && chown 65532:65532 /out/data && chmod 0700 /out/data

# --- Optional: export the static binary for a bare-metal install --------------
# Builds without a Go or Node toolchain on the host (needs BuildKit):
#   docker build -f deploy/Containerfile --build-arg VERSION=v0.1.0 \
#     --target binary --output type=local,dest=out .
#   sudo deploy/debian/install.sh --binary out/dropr
FROM scratch AS binary
COPY --from=go /out/dropr /dropr

# --- 3. Runtime: distroless, non-root, no shell ------------------------------
FROM gcr.io/distroless/static-debian12:nonroot@sha256:52dcfbabb7457ea47c82f6e13af8c8a4a1d9f7b0145142b3ecab20f2b888411d
ARG VERSION=dev
LABEL org.opencontainers.image.title="dropr" \
      org.opencontainers.image.description="Self-hosted, end-to-end encrypted file drop" \
      org.opencontainers.image.source="https://github.com/scttpr/dropr" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}"
# Same path as the Nix-built image (/bin/dropr), so commands and healthchecks
# are identical for both.
COPY --from=go /out/dropr /bin/dropr
COPY --from=go --chown=65532:65532 /out/data /data
USER 65532:65532
WORKDIR /data
VOLUME ["/data"]
EXPOSE 8443/tcp
# No shell or curl in the image: the binary probes its own /healthz. (Kept by
# Docker-format images; OCI images ignore it, set it in Compose instead.)
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["/bin/dropr", "healthcheck", "--config", "/etc/dropr/dropr.toml"]
ENTRYPOINT ["/bin/dropr", "serve", "--config", "/etc/dropr/dropr.toml"]
