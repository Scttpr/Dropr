# Copied to .env by setup.sh. Compose reads it from the project directory.

# Image, pinned by digest after verifying it (SECURITY.md, "Verify the
# container image"):
#   DROPR_IMAGE=ghcr.io/scttpr/dropr@sha256:<digest>
# or an image you built from a verified checkout:
#   docker build -f deploy/Containerfile --build-arg VERSION=v0.1.0 -t dropr:v0.1.0 .
#   DROPR_IMAGE=dropr:v0.1.0
DROPR_IMAGE=

# Host address to publish 443 (and 80) on. Default: all addresses.
#DROPR_BIND=203.0.113.10

# Container memory ceiling. Memory is dominated by 32 MiB part bodies in
# flight (limits.max_transfers in dropr.toml); raise both together.
#DROPR_MEM_LIMIT=4g
