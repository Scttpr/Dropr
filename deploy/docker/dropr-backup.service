# Daily database backup of the Compose deployment in @DIR@ (installed by
# deploy/docker/setup.sh). Run it now: `systemctl start dropr-backup`.
#
# Covers the database only. Copy @DIR@/backups and then @DIR@/data/blobs off
# the host with your backup tool, in that order, and encrypt them. See
# docs/operations.md "Backups". Retention: `systemctl edit dropr-backup`.

[Unit]
Description=Dropr database backup (Compose)
Documentation=https://github.com/scttpr/dropr/blob/main/docs/operations.md#backups
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=@DIR@
Environment=DROPR_BACKUP_KEEP_DAYS=14
ExecStart=/bin/sh -c 'exec docker compose exec -T dropr /bin/dropr backup --config /etc/dropr/dropr.toml --out "/backups/dropr-$$(date -u +%%Y%%m%%dT%%H%%M%%SZ).db"'
ExecStartPost=/usr/bin/find @DIR@/backups -maxdepth 1 -type f -name dropr-*.db -mtime +${DROPR_BACKUP_KEEP_DAYS} -delete
