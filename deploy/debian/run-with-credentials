#!/bin/sh
# Runs `dropr <args> --config <copy>` inside a systemd unit other than
# dropr.service (the admin CLI, the backup timer).
#
# /etc/dropr/dropr.toml names the secrets under /run/credentials/dropr.service/,
# but systemd exposes a unit's credentials under its own name. This writes a
# private copy of the config with those paths pointing at $CREDENTIALS_DIRECTORY,
# so there is a single config file to edit.
#
# Installed as /usr/local/lib/dropr/run-with-credentials by install.sh.
set -eu

: "${CREDENTIALS_DIRECTORY:?run inside a systemd unit with LoadCredential (use dropr-admin)}"
: "${RUNTIME_DIRECTORY:?run inside a systemd unit with RuntimeDirectory (use dropr-admin)}"

conf="$RUNTIME_DIRECTORY/dropr.toml"
umask 077
sed "s#/run/credentials/dropr\.service/#${CREDENTIALS_DIRECTORY}/#g" /etc/dropr/dropr.toml > "$conf"
exec /usr/local/bin/dropr "$@" --config "$conf"
