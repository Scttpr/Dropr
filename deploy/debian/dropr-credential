#!/bin/sh
# Manage Dropr's encrypted credentials, /etc/dropr/credentials/NAME.cred
# (systemd-creds, sealed to the TPM2 when the host has one).
#
#   sudo dropr-credential list
#   sudo dropr-credential edit restic_env       decrypt, open $EDITOR, re-encrypt
#   sudo dropr-credential set restic_env FILE   encrypt FILE (- for stdin)
#   sudo dropr-credential show restic_env       print the decrypted value
#
# Names in use: refresh_key, oidc_key (dropr.service), restic_env (off-site
# backups). Plaintext only ever lands on /run (tmpfs).
#
# Installed as /usr/local/sbin/dropr-credential by install.sh.
set -eu

if [ "$(id -u)" -ne 0 ]; then
  exec sudo -- "$0" "$@"
fi

dir=/etc/dropr/credentials
die() { printf 'dropr-credential: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '5,8p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

cmd=${1:-}
name=${2:-}
case "$cmd" in
  list) ls -l "$dir"; exit 0 ;;
  edit|set|show) ;;
  *) usage ;;
esac
case "$name" in
  ''|*[!a-z0-9_]*) die "credential names are lowercase letters, digits and _" ;;
esac
cred=$dir/$name.cred

seal() { # seal SOURCE
  systemd-creds encrypt --with-key=auto --name="$name" "$1" "$cred.new"
  chmod 0600 "$cred.new"
  mv -f "$cred.new" "$cred"
  case "$name" in
    refresh_key|oidc_key) echo "Sealed $cred. Apply it: systemctl restart dropr" ;;
    *) echo "Sealed $cred" ;;
  esac
}

case "$cmd" in
  show)
    [ -e "$cred" ] || die "no such credential: $cred"
    systemd-creds decrypt --name="$name" "$cred" -
    ;;
  set)
    src=${3:-}
    [ -n "$src" ] || usage
    [ "$src" = - ] || [ -r "$src" ] || die "cannot read $src"
    seal "$src"
    ;;
  edit)
    tmp=$(mktemp -d -p /run dropr-credential.XXXXXX)
    trap 'rm -rf "$tmp"' EXIT INT TERM
    if [ -e "$cred" ]; then
      systemd-creds decrypt --name="$name" "$cred" "$tmp/value"
    else
      : > "$tmp/value"
    fi
    cp "$tmp/value" "$tmp/before"
    "${EDITOR:-editor}" "$tmp/value"
    if cmp -s "$tmp/value" "$tmp/before"; then echo "Unchanged"; exit 0; fi
    seal "$tmp/value"
    ;;
esac
