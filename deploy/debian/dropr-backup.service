# Consistent online backup of the Dropr database (SQLite online backup, safe
# while the server runs). Triggered daily by dropr-backup.timer and by
# install.sh before an upgrade. Run it now: `systemctl start dropr-backup`.
#
# This covers the database only. Copy /var/backups/dropr and then
# /var/lib/dropr/blobs off the host with your backup tool (restic, borg),
# in that order, and encrypt them: the database holds wrapped private keys and
# encrypted refresh tokens. See docs/operations.md "Backups".
#
# Retention: change DROPR_BACKUP_KEEP_DAYS with `systemctl edit dropr-backup`.

[Unit]
Description=Dropr database backup
Documentation=https://github.com/scttpr/dropr/blob/main/docs/operations.md#backups
After=dropr.service

[Service]
Type=oneshot
Environment=DROPR_BACKUP_KEEP_DAYS=14
ExecStart=/bin/sh -c 'exec /usr/local/lib/dropr/run-with-credentials backup --out "/var/backups/dropr/dropr-$$(date -u +%%Y%%m%%dT%%H%%M%%SZ).db"'
ExecStartPost=/usr/bin/find /var/backups/dropr -maxdepth 1 -type f -name dropr-*.db -mtime +${DROPR_BACKUP_KEEP_DAYS} -delete

User=dropr
Group=dropr
StateDirectory=dropr
StateDirectoryMode=0700
RuntimeDirectory=dropr-backup
RuntimeDirectoryMode=0700
ReadWritePaths=/var/backups/dropr
UMask=0077
LoadCredential=refresh_key:/etc/dropr/credentials/refresh_key
LoadCredential=oidc_key:/etc/dropr/credentials/oidc_key.pem
Nice=10
IOSchedulingClass=idle

CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
