# Dropr self-check (/usr/local/lib/dropr/check): health, disk, backup ages,
# certificate expiry. A failure starts dropr-alert@dropr-check.service.
# Thresholds: `systemctl edit dropr-check` (see the script's header).

[Unit]
Description=Dropr self-check
Documentation=https://github.com/scttpr/dropr/blob/main/docs/deploy-debian.md#monitoring-and-alerts
After=dropr.service
OnFailure=dropr-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/dropr/check

User=dropr
Group=dropr
LoadCredentialEncrypted=refresh_key:/etc/dropr/credentials/refresh_key.cred
LoadCredentialEncrypted=oidc_key:/etc/dropr/credentials/oidc_key.cred
RuntimeDirectory=dropr-check
RuntimeDirectoryMode=0700
UMask=0077

CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=disconnected
PrivateDevices=true
ProtectProc=invisible
InaccessiblePaths=-/etc/dropr/credentials
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=strict
ProtectClock=true
ProtectHostname=private
PrivateIPC=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressAllow=localhost
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
