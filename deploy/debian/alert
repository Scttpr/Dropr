#!/bin/sh
# Send an alert that a Dropr unit failed. Runs in dropr-alert@<unit>.service,
# which the Dropr units start through OnFailure=. Settings come from the
# alert_env credential (sudo dropr-credential edit alert_env):
#
#   ALERT_WEBHOOK=https://ntfy.sh/<topic>   POST target (ntfy and similar take plain text)
#   ALERT_WEBHOOK_FORMAT=text               text, or json for Slack/Mattermost ({"text": ...})
#   ALERT_EMAIL=ops@example.com             needs a sendmail (apt install msmtp-mta)
#   ALERT_REPEAT_HOURS=6                    at most one alert per unit in this window
#
# Test: sudo systemctl start dropr-alert@test.service
#
# Installed as /usr/local/lib/dropr/alert by install.sh.
set -eu

unit=${1:?usage: alert UNIT}
: "${CREDENTIALS_DIRECTORY:?run inside dropr-alert@.service}"
: "${STATE_DIRECTORY:?run inside dropr-alert@.service}"

while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    ''|'#'*) ;;
    ALERT_*=*) export "${line?}" ;;
    *) echo "<4>alert_env: ignoring a line that is not ALERT_*=value" ;;
  esac
done < "$CREDENTIALS_DIRECTORY/alert_env"

host=$(hostname)
now=$(date +%s)
repeat=${ALERT_REPEAT_HOURS:-6}
stamp=$STATE_DIRECTORY/$(printf '%s' "$unit" | tr -c 'A-Za-z0-9@._-' '_')
if [ "$unit" != test ] && [ -f "$stamp" ] && [ $((now - $(cat "$stamp"))) -lt $((repeat * 3600)) ]; then
  echo "<5>alert for $unit suppressed: one was sent less than ${repeat} h ago"
  exit 0
fi

subject="Dropr on $host: $unit failed"
logs=$(journalctl --namespace='*' -u "$unit" -n 20 -o short-iso --no-pager -q 2>/dev/null || true)
msg=$(printf '%s at %s\n\n%s\n' "$subject" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${logs:-(no log lines)}")
echo "<2>$subject"

sent=false
if [ -n "${ALERT_WEBHOOK:-}" ]; then
  if [ "${ALERT_WEBHOOK_FORMAT:-text}" = json ]; then
    body=$(printf '%s' "$msg" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/\\t/g' | awk '{printf "%s\\n", $0}')
    printf '{"text":"%s"}' "$body" | curl -fsS --max-time 20 --proto '=https,http' \
      -H 'Content-Type: application/json' --data-binary @- "$ALERT_WEBHOOK" >/dev/null && sent=true
  else
    printf '%s' "$msg" | curl -fsS --max-time 20 --proto '=https,http' \
      -H "Title: $subject" -H 'Content-Type: text/plain; charset=utf-8' --data-binary @- "$ALERT_WEBHOOK" >/dev/null && sent=true
  fi
  $sent || echo "<3>the alert webhook failed"
fi
if [ -n "${ALERT_EMAIL:-}" ]; then
  if command -v sendmail >/dev/null; then
    printf 'To: %s\nSubject: %s\n\n%s\n' "$ALERT_EMAIL" "$subject" "$msg" | sendmail -t && sent=true
  else
    echo "<3>ALERT_EMAIL is set but there is no sendmail (apt install msmtp-mta)"
  fi
fi
if ! $sent; then
  echo "<4>no alert channel delivered this; configure one: sudo dropr-credential edit alert_env"
  [ -n "${ALERT_WEBHOOK:-}${ALERT_EMAIL:-}" ] && exit 1
  exit 0
fi
[ "$unit" = test ] || echo "$now" > "$stamp"
