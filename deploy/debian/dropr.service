# Dropr on a Debian or Ubuntu host (systemd >= 247). Installed by
# deploy/debian/install.sh as /etc/systemd/system/dropr.service.
#
# Local changes go into a drop-in (`systemctl edit dropr`), not into this file:
# install.sh overwrites it on upgrade.
#
# Secrets are passed with LoadCredential: systemd (root) reads them from
# /etc/dropr/credentials (root-only) and exposes read-only copies to this
# service under /run/credentials/dropr.service/. The dropr user itself cannot
# read the originals.
#
# Logs go to a dedicated journal namespace with its own 7-day retention
# (/etc/systemd/journald@dropr.conf): `journalctl --namespace=dropr -f`.

[Unit]
Description=Dropr end-to-end encrypted file drop
Documentation=https://github.com/scttpr/dropr/blob/main/docs/deploy-debian.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/dropr serve --config /etc/dropr/dropr.toml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
LimitNOFILE=65536

User=dropr
Group=dropr
StateDirectory=dropr
StateDirectoryMode=0700
UMask=0077
LoadCredential=refresh_key:/etc/dropr/credentials/refresh_key
LoadCredential=oidc_key:/etc/dropr/credentials/oidc_key.pem
LogNamespace=dropr

# Binding :443 (and :80 with redirect_http) needs this one capability and
# nothing else. Behind a reverse proxy on 127.0.0.1:8080, remove it with a
# drop-in containing empty `CapabilityBoundingSet=` and `AmbientCapabilities=`.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# File system: everything read-only except the state directory.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectProc=invisible
ProcSubset=pid
InaccessiblePaths=-/etc/dropr/credentials

# Kernel and host.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
KeyringMode=private

# Process.
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

# Resource ceilings (raise if needed; memory is dominated by 32 MiB part
# bodies in flight, see docs/operations.md "Capacity planning").
TasksMax=4096
# MemoryMax=4G

[Install]
WantedBy=multi-user.target
