# Dropr on Debian 13 (systemd >= 257). Installed by deploy/debian/install.sh
# as /etc/systemd/system/dropr.service.
#
# Local changes go into a drop-in (`systemctl edit dropr`), not into this file:
# install.sh overwrites it on upgrade.
#
# Secrets are encrypted credentials (systemd-creds, sealed to the TPM2 when
# the host has one): systemd decrypts /etc/dropr/credentials/*.cred and
# exposes read-only copies to this service under
# /run/credentials/dropr.service/. A copy of the disk is useless without the
# TPM, and the dropr user cannot read the originals.
#
# Logs go to a dedicated journal namespace with its own 7-day retention
# (/etc/systemd/journald@dropr.conf): `journalctl --namespace=dropr -f`.

[Unit]
Description=Dropr end-to-end encrypted file drop
Documentation=https://github.com/scttpr/dropr/blob/main/docs/deploy-debian.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/dropr serve --config /etc/dropr/dropr.toml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
LimitNOFILE=65536

User=dropr
Group=dropr
StateDirectory=dropr
StateDirectoryMode=0700
UMask=0077
LoadCredentialEncrypted=refresh_key:/etc/dropr/credentials/refresh_key.cred
LoadCredentialEncrypted=oidc_key:/etc/dropr/credentials/oidc_key.cred
LogNamespace=dropr

# Binding :443 (and :80 with redirect_http) needs this one capability and
# nothing else, and those are the only ports the service may bind. Behind a
# reverse proxy on 127.0.0.1:8080, use a drop-in with empty
# `CapabilityBoundingSet=` and `AmbientCapabilities=`, and
# `SocketBindAllow=tcp:8080`. (No PrivateUsers=: a capability held in a user
# namespace does not allow binding :443 in the host network namespace.)
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
SocketBindAllow=tcp:443
SocketBindAllow=tcp:80
SocketBindDeny=any
NoNewPrivileges=true

# File system: everything read-only except the state directory, and nothing
# executable but the binary itself.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=disconnected
PrivateDevices=true
NoExecPaths=/
ExecPaths=/usr/local/bin/dropr
ProtectProc=invisible
ProcSubset=pid
InaccessiblePaths=-/etc/dropr/credentials

# Kernel and host.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=strict
ProtectClock=true
ProtectHostname=private
PrivateIPC=true
KeyringMode=private

# Process.
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RemoveIPC=true
# TCP only: a unix: listen socket (proxy mode) needs AF_UNIX in a drop-in.
RestrictAddressFamilies=AF_INET AF_INET6
# Link-local covers cloud metadata endpoints (169.254.169.254).
IPAddressDeny=link-local multicast
SystemCallArchitectures=native
SystemCallFilter=@system-service
# @resources: systemd sets LimitNOFILE; Go ignores EPERM from setrlimit.
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# Resource ceilings (raise if needed; memory is dominated by 32 MiB part
# bodies in flight, see docs/operations.md "Capacity planning").
TasksMax=4096
# MemoryMax=4G

[Install]
WantedBy=multi-user.target
