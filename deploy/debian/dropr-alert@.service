# Failure hook: every Dropr unit (dropr, dropr-backup, dropr-offsite,
# dropr-check) starts dropr-alert@<unit>.service through OnFailure=. By
# default it only writes a critical line to the journal. Point it at your own
# alerting with a drop-in, e.g. ntfy:
#
#   sudo systemctl edit dropr-alert@.service
#   [Service]
#   ExecStart=
#   ExecStart=/usr/bin/curl -fsS --max-time 20 -H "Title: Dropr: %i failed" \
#     -d "%i failed on %H" https://ntfy.sh/<a-long-random-topic>
#
# Test: sudo systemctl start dropr-alert@test.service

[Unit]
Description=Dropr alert: %i failed
Documentation=https://github.com/scttpr/dropr/blob/main/docs/deploy-debian.md#monitoring-and-alerts

[Service]
Type=oneshot
ExecStart=/usr/bin/systemd-cat --identifier=dropr-alert --priority=crit /bin/echo "%i failed"

DynamicUser=true
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=disconnected
PrivateDevices=true
ProtectProc=invisible
InaccessiblePaths=-/etc/dropr
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=strict
ProtectClock=true
PrivateIPC=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=link-local multicast
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
