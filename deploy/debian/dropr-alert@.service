# Alert that the unit named by the instance failed (dropr, dropr-backup,
# dropr-offsite, dropr-check reference it with OnFailure=). Sends to the
# webhook and/or email set in the alert_env credential:
#   sudo dropr-credential edit alert_env
# Test: sudo systemctl start dropr-alert@test.service

[Unit]
Description=Dropr alert: %i failed
Documentation=https://github.com/scttpr/dropr/blob/main/docs/deploy-debian.md#monitoring-and-alerts

[Service]
Type=oneshot
ExecStart=/usr/local/lib/dropr/alert %i

DynamicUser=true
SupplementaryGroups=systemd-journal
LoadCredentialEncrypted=alert_env:/etc/dropr/credentials/alert_env.cred
StateDirectory=dropr-alert

CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=disconnected
PrivateDevices=true
ProtectProc=invisible
InaccessiblePaths=-/etc/dropr/credentials
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=strict
ProtectClock=true
PrivateIPC=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=link-local multicast
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
